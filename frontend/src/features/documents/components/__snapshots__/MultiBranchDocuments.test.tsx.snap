exports[`multi-branch printed documents > prints the customer branch on the statement 1`] = `"<article class="document-page customer-statement" aria-label="Customer statement علي الحاج"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black text-slate-950" dir="auto">Home Connect هوم كونكت</h1><p class="user-text-pre mt-1 text-sm text-slate-700" dir="auto">Beirut / بيروت</p><p class="mt-1 text-sm" dir="ltr">01 234 567</p><p class="mt-1 text-sm" dir="ltr">shop@example.com</p><p class="mt-1 text-sm font-semibold" dir="ltr">VAT / الضريبة: VAT-12345</p><p class="user-text mt-1 text-sm" dir="auto">Branch: Main branch — Beirut — 01 234 567</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>CUSTOMER STATEMENT</span><span dir="rtl" class="text-xs font-normal text-slate-500">كشف حساب زبون</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Statement period</span><span dir="rtl" class="text-[0.86em] text-slate-500">فترة كشف الحساب</span></span><p class="font-semibold" dir="ltr">01/01/2026 — 31/01/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Reporting currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">عملة التقرير</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p class="mt-1 text-sm" dir="ltr"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Phone</span><span dir="rtl" class="text-[0.86em] text-slate-500">الهاتف</span></span> 70</p><p class="user-text-pre mt-1 text-sm" dir="auto"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Address</span><span dir="rtl" class="text-[0.86em] text-slate-500">العنوان</span></span> بيروت</p></div><dl class="document-facts"><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Opening balance</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد الافتتاحي</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="openingBalance" data-api-value="25.00">$25.00</span></dd></div><div class="document-total-strong p-2"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Closing balance</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد الختامي</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="closingBalance" data-api-value="75.00">$75.00</span></dd></div></dl></section><table class="document-table statement-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Date</span><span dir="rtl" class="text-[0.86em] text-slate-500">التاريخ</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Entry</span><span dir="rtl" class="text-[0.86em] text-slate-500">القيد</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Original amount</span><span dir="rtl" class="text-[0.86em] text-slate-500">المبلغ الأصلي</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Balance effect</span><span dir="rtl" class="text-[0.86em] text-slate-500">أثر الرصيد</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Running balance</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد الجاري</span></span></th></tr></thead><tbody><tr class=""><td dir="ltr">02/01/2026</td><td><div class="font-semibold">Debt / دين <span class="statement-status statement-status-posted">Posted / مرحّل</span></div><p class="user-text mt-1" dir="auto">Television</p><p class="user-text text-xs text-slate-500" dir="auto">SO-1</p><p class="text-xs text-slate-500" dir="ltr">Due / الاستحقاق: 01/02/2026</p></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.d1.originalAmount" data-api-value="100.00">$100.00</span></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.d1.balanceEffect" data-api-value="100.00">$100.00</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="entries.d1.runningBalance" data-api-value="125.00">$125.00</span></td></tr><tr class=""><td dir="ltr">03/01/2026</td><td><div class="font-semibold">Payment / دفعة <span class="statement-status statement-status-posted">Posted / مرحّل</span></div><p class="user-text mt-1" dir="auto">Payment · CASH</p></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p1.originalAmount" data-api-value="50.00">$50.00</span></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p1.balanceEffect" data-api-value="-50.00">-$50.00</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="entries.p1.runningBalance" data-api-value="75.00">$75.00</span></td></tr><tr class="statement-entry-inactive"><td dir="ltr">04/01/2026</td><td><div class="font-semibold">Payment / دفعة <span class="statement-status statement-status-voided">VOID / ملغاة</span></div><p class="user-text mt-1" dir="auto">Payment · CASH</p><p class="user-text text-xs text-red-700" dir="auto">Duplicate</p></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p2.originalAmount" data-api-value="10.00">$10.00</span></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p2.balanceEffect" data-api-value="0.00">$0.00</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="entries.p2.runningBalance" data-api-value="75.00">$75.00</span></td></tr></tbody></table><section class="statement-aging"><span class="flex flex-col document-section-label"><span>Aging summary</span><span dir="rtl" class="text-xs font-normal text-slate-500">ملخص أعمار الديون</span></span><div class="statement-aging-grid"><div><span>15–30 days / ١٥–٣٠ يوم</span><span dir="ltr" class="tabular-nums" data-api-field="aging.DAYS_15_30" data-api-value="75.00">$75.00</span></div><div class="document-total-strong"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total outstanding</span><span dir="rtl" class="text-[0.86em] text-slate-500">إجمالي المستحق</span></span><span dir="ltr" class="tabular-nums" data-api-field="aging.total" data-api-value="75.00">$75.00</span></div></div></section><footer class="document-footer">Statement generated from posted transactions / كشف مُنشأ من القيود المرحّلة</footer></article>"`;

exports[`multi-branch printed documents > prints the record branch on the payment receipt 1`] = `"<article class="document-page payment-receipt" aria-label="Payment receipt 55555555-5555-4555-8555-555555555555"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black text-slate-950" dir="auto">Home Connect هوم كونكت</h1><p class="user-text-pre mt-1 text-sm text-slate-700" dir="auto">Beirut / بيروت</p><p class="mt-1 text-sm" dir="ltr">01 234 567</p><p class="mt-1 text-sm" dir="ltr">shop@example.com</p><p class="mt-1 text-sm font-semibold" dir="ltr">VAT / الضريبة: VAT-12345</p><p class="user-text mt-1 text-sm" dir="auto">Branch: Main branch — Beirut — 01 234 567</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>PAYMENT RECEIPT</span><span dir="rtl" class="text-xs font-normal text-slate-500">إيصال دفع</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Receipt no.</span><span dir="rtl" class="text-[0.86em] text-slate-500">رقم الإيصال</span></span><p class="font-semibold" dir="ltr">55555555-5555-4555-8555-555555555555</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Date</span><span dir="rtl" class="text-[0.86em] text-slate-500">التاريخ</span></span><p class="font-semibold" dir="ltr">09/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">العملة</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p class="mt-1 text-sm" dir="ltr">70 123 456</p><p class="user-text-pre mt-1 text-sm" dir="auto">بيروت</p></div><dl class="document-facts"><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Amount received</span><span dir="rtl" class="text-[0.86em] text-slate-500">المبلغ المقبوض</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="totalAmount" data-api-value="200.00">$200.00</span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Payment method</span><span dir="rtl" class="text-[0.86em] text-slate-500">طريقة الدفع</span></span></dt><dd class="mt-1 font-semibold"><span>Cash / نقداً</span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Reference</span><span dir="rtl" class="text-[0.86em] text-slate-500">المرجع</span></span></dt><dd class="mt-1 font-semibold"><span class="user-text" dir="auto">RCPT-9</span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Received by</span><span dir="rtl" class="text-[0.86em] text-slate-500">استلمها</span></span></dt><dd class="mt-1 font-semibold"><span class="user-text" dir="auto">Maya Saleh</span></dd></div></dl></section><table class="document-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Allocated to</span><span dir="rtl" class="text-[0.86em] text-slate-500">مخصص إلى</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Type</span><span dir="rtl" class="text-[0.86em] text-slate-500">النوع</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Allocated amount</span><span dir="rtl" class="text-[0.86em] text-slate-500">المبلغ المخصص</span></span></th></tr></thead><tbody><tr><td class="user-text" dir="auto">Kitchen appliances — installment 1</td><td>Installment / قسط</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="allocations.allocation-1.paymentAmount" data-api-value="120.00">$120.00</span></td></tr><tr><td class="user-text" dir="auto">Kitchen appliances — installment 2</td><td>Installment / قسط</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="allocations.allocation-2.paymentAmount" data-api-value="80.00">$80.00</span></td></tr></tbody></table><div class="document-summary"><div></div><dl class="document-totals"><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Remaining balance after payment</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد المتبقي بعد الدفع</span></span><p class="user-text mt-1 text-xs font-normal text-slate-500" dir="auto">Kitchen appliances</p></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="remainingBalances.plan-1" data-api-value="300.00">$300.00</span></dd></div></dl></div><section class="document-notes"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Notes</span><span dir="rtl" class="text-[0.86em] text-slate-500">ملاحظات</span></span><p class="user-text-pre mt-2" dir="auto">دفعة شهر أيلول</p></section><footer class="document-footer">Payment received / تم استلام الدفعة</footer></article>"`;

exports[`multi-branch printed documents > prints the record branch on the sales invoice 1`] = `"<article class="document-page sales-invoice" aria-label="Invoice SO-2026-0001"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black text-slate-950" dir="auto">Home Connect هوم كونكت</h1><p class="user-text-pre mt-1 text-sm text-slate-700" dir="auto">Beirut / بيروت</p><p class="mt-1 text-sm" dir="ltr">01 234 567</p><p class="mt-1 text-sm" dir="ltr">shop@example.com</p><p class="mt-1 text-sm font-semibold" dir="ltr">VAT / الضريبة: VAT-12345</p><p class="user-text mt-1 text-sm" dir="auto">Branch: Main branch — Beirut — 01 234 567</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>SALES INVOICE</span><span dir="rtl" class="text-xs font-normal text-slate-500">فاتورة مبيعات</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Invoice no.</span><span dir="rtl" class="text-[0.86em] text-slate-500">رقم الفاتورة</span></span><p class="font-semibold" dir="ltr">SO-2026-0001</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Date</span><span dir="rtl" class="text-[0.86em] text-slate-500">التاريخ</span></span><p class="font-semibold" dir="ltr">09/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">العملة</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p class="mt-1 text-sm" dir="ltr">70 123 456</p><p class="user-text-pre mt-1 text-sm" dir="auto">الحمرا، بيروت</p></div><dl class="document-facts"><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Payment status</span><span dir="rtl" class="text-[0.86em] text-slate-500">حالة الدفع</span></span></dt><dd class="mt-1 font-semibold"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Partially paid</span><span dir="rtl" class="text-[0.86em] text-slate-500">مدفوع جزئياً</span></span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Debt due date</span><span dir="rtl" class="text-[0.86em] text-slate-500">تاريخ استحقاق الدين</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr">09/10/2026</span></dd></div></dl></section><table class="document-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Item</span><span dir="rtl" class="text-[0.86em] text-slate-500">الصنف</span></span></th><th class="text-center"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Qty</span><span dir="rtl" class="text-[0.86em] text-slate-500">الكمية</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Unit price</span><span dir="rtl" class="text-[0.86em] text-slate-500">سعر الوحدة</span></span></th><th class="text-center"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT rate</span><span dir="rtl" class="text-[0.86em] text-slate-500">نسبة الضريبة</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الضريبة</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Line total incl. VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الإجمالي شامل الضريبة</span></span></th></tr></thead><tbody><tr><td><p class="user-text font-semibold" dir="auto">براد أبيض</p><p class="user-text text-xs text-slate-500" dir="auto">FR-100</p></td><td class="text-center tabular-nums" dir="ltr">1</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="items.55555555-5555-4555-8555-555555555555.unitPrice" data-api-value="100.00">$100.00</span></td><td class="text-center tabular-nums" dir="ltr">11.000%</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="items.55555555-5555-4555-8555-555555555555.vatAmount" data-api-value="9.91">$9.91</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="items.55555555-5555-4555-8555-555555555555.lineTotalIncVat" data-api-value="100.00">$100.00</span></td></tr></tbody></table><div class="document-summary"><div class="text-sm text-slate-600"><p><strong>Delivery VAT / ضريبة التوصيل:</strong> Standard-rated / خاضع للنسبة القياسية</p><p class="mt-1" dir="ltr">LB_STANDARD · 11.000%</p></div><dl class="document-totals"><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Items subtotal before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">مجموع الأصناف قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="itemsSubtotal" data-api-value="90.09">$90.09</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Delivery before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">التوصيل قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="deliveryFeeExVat" data-api-value="9.01">$9.01</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Delivery VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">ضريبة التوصيل</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="deliveryVatAmount" data-api-value="0.99">$0.99</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Subtotal before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">المجموع قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="subtotalExVat" data-api-value="99.10">$99.10</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">إجمالي الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="vatAmount" data-api-value="10.90">$10.90</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total incl. VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الإجمالي شامل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="totalAmount" data-api-value="110.00">$110.00</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Paid</span><span dir="rtl" class="text-[0.86em] text-slate-500">المدفوع</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="paidAmount" data-api-value="60.00">$60.00</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Remaining</span><span dir="rtl" class="text-[0.86em] text-slate-500">المتبقي</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="remainingAmount" data-api-value="50.00">$50.00</span></dd></div></dl></div><section class="document-notes"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Notes</span><span dir="rtl" class="text-[0.86em] text-slate-500">ملاحظات</span></span><p class="user-text-pre mt-2" dir="auto">ضمان سنة</p><p class="user-text-pre mt-2" dir="auto">الطابق الثاني</p></section><footer class="document-footer">Thank you / شكراً لكم</footer></article>"`;

exports[`multi-branch printed documents > prints the record branch on the sales return 1`] = `"<article class="document-page sales-return-document" aria-label="Sales return SO-1-R1"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black" dir="auto">Home Connect هوم كونكت</h1><p class="user-text-pre mt-1 text-sm" dir="auto">Beirut / بيروت</p><p class="mt-1 text-sm" dir="ltr">01 234 567</p><p class="mt-1 text-sm" dir="ltr">VAT / الضريبة: VAT-12345</p><p class="user-text mt-1 text-sm" dir="auto">Branch: Main branch — Beirut — 01 234 567</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>SALES RETURN</span><span dir="rtl" class="text-xs font-normal text-slate-500">مرتجع مبيعات</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Return no.</span><span dir="rtl" class="text-[0.86em] text-slate-500">رقم المرتجع</span></span><p class="font-semibold" dir="ltr">SO-1-R1</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Original invoice</span><span dir="rtl" class="text-[0.86em] text-slate-500">الفاتورة الأصلية</span></span><p class="font-semibold" dir="ltr">SO-1</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Sale date</span><span dir="rtl" class="text-[0.86em] text-slate-500">تاريخ البيع</span></span><p class="font-semibold" dir="ltr">01/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Return date</span><span dir="rtl" class="text-[0.86em] text-slate-500">تاريخ الإرجاع</span></span><p class="font-semibold" dir="ltr">10/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">العملة</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p dir="ltr">70 000 000</p></div><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Processed by</span><span dir="rtl" class="text-[0.86em] text-slate-500">تمت المعالجة بواسطة</span></span><p class="mt-2 font-bold">Maya Saleh</p><p class="text-sm text-slate-500">@maya</p></div></section><table class="document-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Item</span><span dir="rtl" class="text-[0.86em] text-slate-500">الصنف</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Qty</span><span dir="rtl" class="text-[0.86em] text-slate-500">الكمية</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Original unit price</span><span dir="rtl" class="text-[0.86em] text-slate-500">سعر الوحدة الأصلي</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الضريبة</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total incl. VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الإجمالي شامل الضريبة</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Disposition</span><span dir="rtl" class="text-[0.86em] text-slate-500">حالة المخزون</span></span></th></tr></thead><tbody><tr><td><p class="user-text font-semibold" dir="auto">Fridge / براد</p><p class="text-xs text-slate-500">F-1</p></td><td class="text-center">1</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="items.line-1.unitPriceSnapshot" data-api-value="100.00">$100.00</span></td><td class="text-right"><span class="block text-xs">11.000%</span><span dir="ltr" class="tabular-nums" data-api-field="items.line-1.vatAmount" data-api-value="9.91">$9.91</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="items.line-1.totalIncVat" data-api-value="100.00">$100.00</span></td><td>Damaged / تالف</td></tr></tbody></table><div class="document-summary"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Refund method</span><span dir="rtl" class="text-[0.86em] text-slate-500">طريقة الاسترداد</span></span><p class="mt-2">Cash refund / استرداد نقدي</p></div><dl class="document-totals"><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Subtotal before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">المجموع قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="subtotalExVat" data-api-value="90.09">$90.09</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="vatAmount" data-api-value="9.91">$9.91</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Return total</span><span dir="rtl" class="text-[0.86em] text-slate-500">إجمالي المرتجع</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="totalIncVat" data-api-value="100.00">$100.00</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Applied to outstanding</span><span dir="rtl" class="text-[0.86em] text-slate-500">المحسوم من الرصيد</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="receivableReliefAmount" data-api-value="50.00">$50.00</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Refundable</span><span dir="rtl" class="text-[0.86em] text-slate-500">القابل للاسترداد</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="refundableAmount" data-api-value="50.00">$50.00</span></dd></div></dl></div><section class="document-notes"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Reason</span><span dir="rtl" class="text-[0.86em] text-slate-500">السبب</span></span><p class="user-text-pre mt-2" dir="auto">Damaged on arrival / تالف عند الوصول</p></section><footer class="document-footer">This document reverses part or all of the original sale without altering the original invoice.<br/><span dir="rtl">يعكس هذا المستند جزءاً من البيع الأصلي أو كله دون تعديل الفاتورة الأصلية.</span></footer></article>"`;
