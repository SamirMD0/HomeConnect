// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CustomerStatementDocument > prints bilingual transaction-derived balances and aging without client calculation 1`] = `"<article class="document-page customer-statement" aria-label="Customer statement علي الحاج"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black text-slate-950" dir="auto">Home Connect</h1><p class="user-text-pre mt-1 text-sm text-slate-700" dir="auto">Beirut</p><p class="mt-1 text-sm" dir="ltr">01</p><p class="mt-1 text-sm" dir="ltr">[Email not configured / البريد الإلكتروني غير مضبوط]</p><p class="mt-1 text-sm font-semibold" dir="ltr">VAT / الضريبة: VAT-1</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>CUSTOMER STATEMENT</span><span dir="rtl" class="text-xs font-normal text-slate-500">كشف حساب زبون</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Statement period</span><span dir="rtl" class="text-[0.86em] text-slate-500">فترة كشف الحساب</span></span><p class="font-semibold" dir="ltr">01/01/2026 — 31/01/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Reporting currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">عملة التقرير</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p class="mt-1 text-sm" dir="ltr"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Phone</span><span dir="rtl" class="text-[0.86em] text-slate-500">الهاتف</span></span> 70</p><p class="user-text-pre mt-1 text-sm" dir="auto"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Address</span><span dir="rtl" class="text-[0.86em] text-slate-500">العنوان</span></span> بيروت</p></div><dl class="document-facts"><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Opening balance</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد الافتتاحي</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="openingBalance" data-api-value="25.00">$25.00</span></dd></div><div class="document-total-strong p-2"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Closing balance</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد الختامي</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="closingBalance" data-api-value="75.00">$75.00</span></dd></div></dl></section><table class="document-table statement-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Date</span><span dir="rtl" class="text-[0.86em] text-slate-500">التاريخ</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Entry</span><span dir="rtl" class="text-[0.86em] text-slate-500">القيد</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Original amount</span><span dir="rtl" class="text-[0.86em] text-slate-500">المبلغ الأصلي</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Balance effect</span><span dir="rtl" class="text-[0.86em] text-slate-500">أثر الرصيد</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Running balance</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد الجاري</span></span></th></tr></thead><tbody><tr class=""><td dir="ltr">02/01/2026</td><td><div class="font-semibold">Debt / دين <span class="statement-status statement-status-posted">Posted / مرحّل</span></div><p class="user-text mt-1" dir="auto">Television</p><p class="user-text text-xs text-slate-500" dir="auto">SO-1</p><p class="text-xs text-slate-500" dir="ltr">Due / الاستحقاق: 01/02/2026</p></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.d1.originalAmount" data-api-value="100.00">$100.00</span></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.d1.balanceEffect" data-api-value="100.00">$100.00</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="entries.d1.runningBalance" data-api-value="125.00">$125.00</span></td></tr><tr class=""><td dir="ltr">03/01/2026</td><td><div class="font-semibold">Payment / دفعة <span class="statement-status statement-status-posted">Posted / مرحّل</span></div><p class="user-text mt-1" dir="auto">Payment · CASH</p></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p1.originalAmount" data-api-value="50.00">$50.00</span></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p1.balanceEffect" data-api-value="-50.00">-$50.00</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="entries.p1.runningBalance" data-api-value="75.00">$75.00</span></td></tr><tr class="statement-entry-inactive"><td dir="ltr">04/01/2026</td><td><div class="font-semibold">Payment / دفعة <span class="statement-status statement-status-voided">VOID / ملغاة</span></div><p class="user-text mt-1" dir="auto">Payment · CASH</p><p class="user-text text-xs text-red-700" dir="auto">Duplicate</p></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p2.originalAmount" data-api-value="10.00">$10.00</span></td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="entries.p2.balanceEffect" data-api-value="0.00">$0.00</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="entries.p2.runningBalance" data-api-value="75.00">$75.00</span></td></tr></tbody></table><section class="statement-aging"><span class="flex flex-col document-section-label"><span>Aging summary</span><span dir="rtl" class="text-xs font-normal text-slate-500">ملخص أعمار الديون</span></span><div class="statement-aging-grid"><div><span>15–30 days / ١٥–٣٠ يوم</span><span dir="ltr" class="tabular-nums" data-api-field="aging.DAYS_15_30" data-api-value="75.00">$75.00</span></div><div class="document-total-strong"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total outstanding</span><span dir="rtl" class="text-[0.86em] text-slate-500">إجمالي المستحق</span></span><span dir="ltr" class="tabular-nums" data-api-field="aging.total" data-api-value="75.00">$75.00</span></div></div></section><footer class="document-footer">Statement generated from posted transactions / كشف مُنشأ من القيود المرحّلة</footer></article>"`;
