// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SalesInvoiceDocument > matches the reviewed bilingual invoice snapshot and direction rules 1`] = `"<article class="document-page sales-invoice" aria-label="Invoice SO-2026-0001"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black text-slate-950" dir="auto">Home Connect هوم كونكت</h1><p class="user-text-pre mt-1 text-sm text-slate-700" dir="auto">Beirut / بيروت</p><p class="mt-1 text-sm" dir="ltr">01 234 567</p><p class="mt-1 text-sm" dir="ltr">shop@example.com</p><p class="mt-1 text-sm font-semibold" dir="ltr">VAT / الضريبة: VAT-12345</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>SALES INVOICE</span><span dir="rtl" class="text-xs font-normal text-slate-500">فاتورة مبيعات</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Invoice no.</span><span dir="rtl" class="text-[0.86em] text-slate-500">رقم الفاتورة</span></span><p class="font-semibold" dir="ltr">SO-2026-0001</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Date</span><span dir="rtl" class="text-[0.86em] text-slate-500">التاريخ</span></span><p class="font-semibold" dir="ltr">09/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">العملة</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p class="mt-1 text-sm" dir="ltr">70 123 456</p><p class="user-text-pre mt-1 text-sm" dir="auto">الحمرا، بيروت</p></div><dl class="document-facts"><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Payment status</span><span dir="rtl" class="text-[0.86em] text-slate-500">حالة الدفع</span></span></dt><dd class="mt-1 font-semibold"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Partially paid</span><span dir="rtl" class="text-[0.86em] text-slate-500">مدفوع جزئياً</span></span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Debt due date</span><span dir="rtl" class="text-[0.86em] text-slate-500">تاريخ استحقاق الدين</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr">09/10/2026</span></dd></div></dl></section><table class="document-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Item</span><span dir="rtl" class="text-[0.86em] text-slate-500">الصنف</span></span></th><th class="text-center"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Qty</span><span dir="rtl" class="text-[0.86em] text-slate-500">الكمية</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Unit price</span><span dir="rtl" class="text-[0.86em] text-slate-500">سعر الوحدة</span></span></th><th class="text-center"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT rate</span><span dir="rtl" class="text-[0.86em] text-slate-500">نسبة الضريبة</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الضريبة</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Line total incl. VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الإجمالي شامل الضريبة</span></span></th></tr></thead><tbody><tr><td><p class="user-text font-semibold" dir="auto">براد أبيض</p><p class="user-text text-xs text-slate-500" dir="auto">FR-100</p></td><td class="text-center tabular-nums" dir="ltr">1</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="items.55555555-5555-4555-8555-555555555555.unitPrice" data-api-value="100.00">$100.00</span></td><td class="text-center tabular-nums" dir="ltr">11.000%</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="items.55555555-5555-4555-8555-555555555555.vatAmount" data-api-value="9.91">$9.91</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="items.55555555-5555-4555-8555-555555555555.lineTotalIncVat" data-api-value="100.00">$100.00</span></td></tr></tbody></table><div class="document-summary"><div class="text-sm text-slate-600"><p><strong>Delivery VAT / ضريبة التوصيل:</strong> Standard-rated / خاضع للنسبة القياسية</p><p class="mt-1" dir="ltr">LB_STANDARD · 11.000%</p></div><dl class="document-totals"><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Items subtotal before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">مجموع الأصناف قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="itemsSubtotal" data-api-value="90.09">$90.09</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Delivery before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">التوصيل قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="deliveryFeeExVat" data-api-value="9.01">$9.01</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Delivery VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">ضريبة التوصيل</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="deliveryVatAmount" data-api-value="0.99">$0.99</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Subtotal before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">المجموع قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="subtotalExVat" data-api-value="99.10">$99.10</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">إجمالي الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="vatAmount" data-api-value="10.90">$10.90</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total incl. VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الإجمالي شامل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="totalAmount" data-api-value="110.00">$110.00</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Paid</span><span dir="rtl" class="text-[0.86em] text-slate-500">المدفوع</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="paidAmount" data-api-value="60.00">$60.00</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Remaining</span><span dir="rtl" class="text-[0.86em] text-slate-500">المتبقي</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="remainingAmount" data-api-value="50.00">$50.00</span></dd></div></dl></div><section class="document-notes"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Notes</span><span dir="rtl" class="text-[0.86em] text-slate-500">ملاحظات</span></span><p class="user-text-pre mt-2" dir="auto">ضمان سنة</p><p class="user-text-pre mt-2" dir="auto">الطابق الثاني</p></section><footer class="document-footer">Thank you / شكراً لكم</footer></article>"`;
