// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PaymentReceiptDocument > matches the bilingual receipt snapshot and prints split API allocations 1`] = `"<article class="document-page payment-receipt" aria-label="Payment receipt 55555555-5555-4555-8555-555555555555"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black text-slate-950" dir="auto">Home Connect هوم كونكت</h1><p class="user-text-pre mt-1 text-sm text-slate-700" dir="auto">Beirut / بيروت</p><p class="mt-1 text-sm" dir="ltr">01 234 567</p><p class="mt-1 text-sm" dir="ltr">shop@example.com</p><p class="mt-1 text-sm font-semibold" dir="ltr">VAT / الضريبة: VAT-12345</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>PAYMENT RECEIPT</span><span dir="rtl" class="text-xs font-normal text-slate-500">إيصال دفع</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Receipt no.</span><span dir="rtl" class="text-[0.86em] text-slate-500">رقم الإيصال</span></span><p class="font-semibold" dir="ltr">55555555-5555-4555-8555-555555555555</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Date</span><span dir="rtl" class="text-[0.86em] text-slate-500">التاريخ</span></span><p class="font-semibold" dir="ltr">09/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">العملة</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p class="mt-1 text-sm" dir="ltr">70 123 456</p><p class="user-text-pre mt-1 text-sm" dir="auto">بيروت</p></div><dl class="document-facts"><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Amount received</span><span dir="rtl" class="text-[0.86em] text-slate-500">المبلغ المقبوض</span></span></dt><dd class="mt-1 font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="totalAmount" data-api-value="200.00">$200.00</span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Payment method</span><span dir="rtl" class="text-[0.86em] text-slate-500">طريقة الدفع</span></span></dt><dd class="mt-1 font-semibold"><span>Cash / نقداً</span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Reference</span><span dir="rtl" class="text-[0.86em] text-slate-500">المرجع</span></span></dt><dd class="mt-1 font-semibold"><span class="user-text" dir="auto">RCPT-9</span></dd></div><div><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-semibold text-slate-500"><span>Received by</span><span dir="rtl" class="text-[0.86em] text-slate-500">استلمها</span></span></dt><dd class="mt-1 font-semibold"><span class="user-text" dir="auto">Maya Saleh</span></dd></div></dl></section><table class="document-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Allocated to</span><span dir="rtl" class="text-[0.86em] text-slate-500">مخصص إلى</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Type</span><span dir="rtl" class="text-[0.86em] text-slate-500">النوع</span></span></th><th class="text-right"><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Allocated amount</span><span dir="rtl" class="text-[0.86em] text-slate-500">المبلغ المخصص</span></span></th></tr></thead><tbody><tr><td class="user-text" dir="auto">Kitchen appliances — installment 1</td><td>Installment / قسط</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="allocations.allocation-1.paymentAmount" data-api-value="120.00">$120.00</span></td></tr><tr><td class="user-text" dir="auto">Kitchen appliances — installment 2</td><td>Installment / قسط</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="allocations.allocation-2.paymentAmount" data-api-value="80.00">$80.00</span></td></tr></tbody></table><div class="document-summary"><div></div><dl class="document-totals"><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Remaining balance after payment</span><span dir="rtl" class="text-[0.86em] text-slate-500">الرصيد المتبقي بعد الدفع</span></span><p class="user-text mt-1 text-xs font-normal text-slate-500" dir="auto">Kitchen appliances</p></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="remainingBalances.plan-1" data-api-value="300.00">$300.00</span></dd></div></dl></div><section class="document-notes"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Notes</span><span dir="rtl" class="text-[0.86em] text-slate-500">ملاحظات</span></span><p class="user-text-pre mt-2" dir="auto">دفعة شهر أيلول</p></section><footer class="document-footer">Payment received / تم استلام الدفعة</footer></article>"`;
