exports[`SalesReturnDocument > matches the bilingual snapshot and renders only stored transaction values 1`] = `"<article class="document-page sales-return-document" aria-label="Sales return SO-1-R1"><header class="document-header"><div class="flex min-w-0 items-start gap-4"><div class="document-logo-placeholder">Logo<br/><span dir="rtl">الشعار</span></div><div class="min-w-0"><h1 class="user-text text-2xl font-black" dir="auto">Home Connect</h1><p class="user-text-pre mt-1 text-sm" dir="auto">Beirut</p><p class="mt-1 text-sm" dir="ltr">01</p><p class="mt-1 text-sm" dir="ltr">VAT / الضريبة: VAT-1</p></div></div><div class="text-right"><span class="flex flex-col text-xl font-black text-brand-800"><span>SALES RETURN</span><span dir="rtl" class="text-xs font-normal text-slate-500">مرتجع مبيعات</span></span><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Return no.</span><span dir="rtl" class="text-[0.86em] text-slate-500">رقم المرتجع</span></span><p class="font-semibold" dir="ltr">SO-1-R1</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Original invoice</span><span dir="rtl" class="text-[0.86em] text-slate-500">الفاتورة الأصلية</span></span><p class="font-semibold" dir="ltr">SO-1</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Sale date</span><span dir="rtl" class="text-[0.86em] text-slate-500">تاريخ البيع</span></span><p class="font-semibold" dir="ltr">01/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Return date</span><span dir="rtl" class="text-[0.86em] text-slate-500">تاريخ الإرجاع</span></span><p class="font-semibold" dir="ltr">10/09/2026</p></div><div class="mt-2"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 justify-end text-xs font-semibold text-slate-500"><span>Currency</span><span dir="rtl" class="text-[0.86em] text-slate-500">العملة</span></span><p class="font-semibold" dir="ltr">USD</p></div></div></header><section class="document-info-grid"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Customer</span><span dir="rtl" class="text-[0.86em] text-slate-500">الزبون</span></span><p class="user-text mt-2 font-bold" dir="auto">علي الحاج</p><p dir="ltr">70 000 000</p></div><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 document-section-label"><span>Processed by</span><span dir="rtl" class="text-[0.86em] text-slate-500">تمت المعالجة بواسطة</span></span><p class="mt-2 font-bold">Maya Saleh</p><p class="text-sm text-slate-500">@maya</p></div></section><table class="document-table"><thead><tr><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Item</span><span dir="rtl" class="text-[0.86em] text-slate-500">الصنف</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Qty</span><span dir="rtl" class="text-[0.86em] text-slate-500">الكمية</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Original unit price</span><span dir="rtl" class="text-[0.86em] text-slate-500">سعر الوحدة الأصلي</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الضريبة</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Total incl. VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الإجمالي شامل الضريبة</span></span></th><th><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Disposition</span><span dir="rtl" class="text-[0.86em] text-slate-500">حالة المخزون</span></span></th></tr></thead><tbody><tr><td><p class="user-text font-semibold" dir="auto">Fridge / براد</p><p class="text-xs text-slate-500">F-1</p></td><td class="text-center">1</td><td class="text-right"><span dir="ltr" class="tabular-nums" data-api-field="items.line-1.unitPriceSnapshot" data-api-value="100.00">$100.00</span></td><td class="text-right"><span class="block text-xs">11.000%</span><span dir="ltr" class="tabular-nums" data-api-field="items.line-1.vatAmount" data-api-value="9.91">$9.91</span></td><td class="text-right font-semibold"><span dir="ltr" class="tabular-nums" data-api-field="items.line-1.totalIncVat" data-api-value="100.00">$100.00</span></td><td>Damaged / تالف</td></tr></tbody></table><div class="document-summary"><div><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Refund method</span><span dir="rtl" class="text-[0.86em] text-slate-500">طريقة الاسترداد</span></span><p class="mt-2">Cash refund / استرداد نقدي</p></div><dl class="document-totals"><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Subtotal before VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">المجموع قبل الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="subtotalExVat" data-api-value="90.09">$90.09</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>VAT</span><span dir="rtl" class="text-[0.86em] text-slate-500">الضريبة</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="vatAmount" data-api-value="9.91">$9.91</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Return total</span><span dir="rtl" class="text-[0.86em] text-slate-500">إجمالي المرتجع</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="totalIncVat" data-api-value="100.00">$100.00</span></dd></div><div class=""><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Applied to outstanding</span><span dir="rtl" class="text-[0.86em] text-slate-500">المحسوم من الرصيد</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="receivableReliefAmount" data-api-value="50.00">$50.00</span></dd></div><div class="document-total-strong"><dt><span class="inline-flex flex-wrap items-baseline gap-x-1.5"><span>Refundable</span><span dir="rtl" class="text-[0.86em] text-slate-500">القابل للاسترداد</span></span></dt><dd><span dir="ltr" class="tabular-nums" data-api-field="refundableAmount" data-api-value="50.00">$50.00</span></dd></div></dl></div><section class="document-notes"><span class="inline-flex flex-wrap items-baseline gap-x-1.5 font-bold"><span>Reason</span><span dir="rtl" class="text-[0.86em] text-slate-500">السبب</span></span><p class="user-text-pre mt-2" dir="auto">Damaged on arrival / تالف عند الوصول</p></section><footer class="document-footer">This document reverses part or all of the original sale without altering the original invoice.<br/><span dir="rtl">يعكس هذا المستند جزءاً من البيع الأصلي أو كله دون تعديل الفاتورة الأصلية.</span></footer></article>"`;
