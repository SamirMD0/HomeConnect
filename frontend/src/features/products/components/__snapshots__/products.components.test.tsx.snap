exports[`product management frontend > keeps the mobile product list card markup stable 1`] = `"<article class="rounded-lg border bg-white shadow-sm border-slate-200"><div class="flex items-start justify-between gap-3 p-4"><label class="flex min-w-0 items-start gap-3"><input type="checkbox" aria-label="Select مروحة سقف" class="mt-1 h-4 w-4 shrink-0 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"/><div class="flex items-center justify-center bg-slate-100 text-slate-300 h-12 w-12 shrink-0 rounded-md border border-slate-200" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package h-1/2 w-1/2" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg></div><span class="min-w-0"><span class="user-text block truncate font-semibold text-slate-900" dir="auto">مروحة سقف</span><span class="user-text block truncate text-sm text-slate-500" dir="auto">CF-52 · Ariete</span><span class="block truncate font-mono text-[11px] text-slate-400">8901643123456</span><span class="block truncate font-mono text-[11px] font-semibold text-slate-600">HC-000001</span></span></label><span class="inline-flex whitespace-nowrap rounded-md border px-2 py-1 text-xs font-semibold border-emerald-200 bg-emerald-50 text-emerald-700">Active / نشط</span></div><div class="border-t border-slate-100 px-4 py-3"><div class="mb-3"><span class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"