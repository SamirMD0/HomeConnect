// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FeatureIconsPage > renders a filled icon at the card feature-mark size 1`] = `"<figure aria-label="Try in card preview" class="space-y-2 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-3"><figcaption><span class="block text-sm font-semibold text-slate-700">Try in card</span><span class="text-xs text-slate-500">Live 5 mm feature-mark preview. The server may reject unsafe SVG on save.</span></figcaption><div class="feature-icon-card-preview"><div class="pricing-card-features pricing-card-features-row" aria-label="Features"><div class="pricing-card-feature"><span class="pricing-card-feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M2 2h20v20H2z"></path></svg></span><span class="pricing-card-feature-copy"><strong>QLED</strong></span></div></div></div></figure>"`;
