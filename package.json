{
  "name": "home-connect",
  "version": "1.9.6",
  "main": "dist/electron/desktop/src/index.js",
  "build": {
    "appId": "com.homeconnect.desktop",
    "productName": "HomeConnect",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "package.json",
      "dist/electron/**/*",
      "!dist/electron/**/*.test.*",
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/client/**/*",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/__tests__/**",
      "!release/**",
      "!docs/**",
      "!backend/.env",
      "!**/.env",
      "!**/.git/**",
      "!**/.cache/**",
      "!**/HomeConnect Backups/**",
      "!**/*.backup"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/bcrypt/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/server/backend",
        "to": "dist/server/backend",
        "filter": [
          "**/*",
          "!**/*.test.*",
          "!**/*.spec.*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/.prisma/client",
        "to": "app.asar.unpacked/node_modules/.prisma/client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/prisma/migrations",
        "to": "prisma/migrations",
        "filter": [
          "**/*.sql",
          "**/migration_lock.toml"
        ]
      },
      {
        "from": "backend/prisma/repair",
        "to": "repair",
        "filter": [
          "**/*.sql",
          "manifest.json"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/homeconnects-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HomeConnect"
    }
  },
  "scripts": {
    "dev:vite": "vite frontend",
    "dev:server": "nodemon --watch backend/src -e ts --exec tsx backend/src/index.ts",
    "dev:electron": "tsx desktop/scripts/dev-electron.ts",
    "electron": "npm run build && npm run build:electron-main && electron .",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "build:electron-main": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/electron/desktop/src',{recursive:true});fs.mkdirSync('dist/electron/desktop/assets',{recursive:true});fs.copyFileSync('desktop/src/startup-monitor.html','dist/electron/desktop/src/startup-monitor.html');for(const file of ['homeconnects-logo.png','homeconnects-logo.ico'])fs.copyFileSync('desktop/assets/'+file,'dist/electron/desktop/assets/'+file);\"",
    "check:electron-production-runtime": "tsx desktop/scripts/check-production-runtime.ts",
    "bundle:setup": "powershell -ExecutionPolicy Bypass -File scripts/Build-SetupBundle.ps1",
    "rehearse:migrations": "tsx scripts/rehearse-migrations.ts",
    "clean:prisma-tmp": "node -e \"const fs=require('fs'),p='node_modules/.prisma/client';if(fs.existsSync(p)){let n=0;for(const f of fs.readdirSync(p))if(f.includes('.tmp')){fs.unlinkSync(p+'/'+f);n++;}console.log('removed '+n+' orphaned prisma engine temp file(s)');}\"",
    "pack:win": "npm run clean:prisma-tmp && npm run build && npm run build:electron-main && electron-builder --win --dir --config.npmRebuild=false --publish=never",
    "dist:win": "npm run clean:prisma-tmp && npm run build && npm run build:electron-main && electron-builder --win --config.npmRebuild=false --publish=never",
    "dev:urls": "tsx scripts/dev-urls.ts",
    "dev": "npm run dev:urls && concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "build": "vite build frontend && tsc -p tsconfig.server.json",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "tsc -p tsconfig.json --noEmit",
    "typecheck:backend": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "prisma:validate": "tsx backend/prisma/validate.ts",
    "lint": "eslint frontend/src backend/src desktop/src --ext ts,tsx",
    "format": "prettier --write \"{frontend,backend,desktop}/src/**/*.{ts,tsx,css}\"",
    "scratch:release": "tsx scripts/build-release-scratch.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "HomeConnect local desktop business management application.",
  "devDependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "date-fns": "^4.4.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.26.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  }
}
