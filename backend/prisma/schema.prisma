// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TransactionType {
  ONE_TIME
  INSTALLMENT
  PAYMENT
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PARTIAL
  PAID
}

enum DebtStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InstallmentPlanFrequency {
  MONTHLY
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  username            String    @unique
  password            String
  fullName            String
  role                Role      @default(EMPLOYEE)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  branchId            String?   @db.Uuid

  transactions              Transaction[]
  activityLogs              ActivityLog[]
  debtsCreated              Debt[]            @relation("DebtCreatedBy")
  debtsCancelled            Debt[]            @relation("DebtCancelledBy")
  installmentPlansCreated   InstallmentPlan[] @relation("InstallmentPlanCreatedBy")
  installmentPlansCancelled InstallmentPlan[] @relation("InstallmentPlanCancelledBy")
  paymentsCreated           Payment[]         @relation("PaymentCreatedBy")
  paymentsVoided            Payment[]         @relation("PaymentVoidedBy")

  @@map("users")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  address   String?
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.Uuid
  branchId  String?   @db.Uuid

  transactions     Transaction[]
  debts            Debt[]
  installmentPlans InstallmentPlan[]
  payments         Payment[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  customer        Customer          @relation(fields: [customerId], references: [id])
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(12, 2)
  description     String
  date            DateTime          @default(now())
  dueDate         DateTime?
  referenceNumber String?
  metadata        Json?
  createdBy       String            @db.Uuid
  user            User              @relation(fields: [createdBy], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  deletedAt       DateTime?
  branchId        String?           @db.Uuid
  parentId        String?           @db.Uuid
  parent          Transaction?      @relation("TransactionToTransaction", fields: [parentId], references: [id])
  payments        Transaction[]     @relation("TransactionToTransaction")

  @@index([customerId])
  @@index([date])
  @@index([type])
  @@index([customerId, date])
  @@index([deletedAt])
  @@map("transactions")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String   @db.Uuid
  details    Json
  ipAddress  String?
  createdAt  DateTime @default(now())
  branchId   String?  @db.Uuid

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Debt {
  id             String     @id @default(uuid()) @db.Uuid
  customerId     String     @db.Uuid
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  description    String
  originalAmount Decimal    @db.Decimal(12, 2)
  dueDate        DateTime   @db.Date
  status         DebtStatus @default(UNPAID)
  notes          String?    @db.Text
  createdById    String     @db.Uuid
  createdBy      User       @relation("DebtCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  cancelledAt    DateTime?
  cancelledById  String?    @db.Uuid
  cancelledBy    User?      @relation("DebtCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason   String?    @db.Text

  paymentAllocations PaymentAllocation[]

  @@index([customerId])
  @@index([dueDate])
  @@index([status])
  @@index([customerId, status])
  @@map("debts")
}

model InstallmentPlan {
  id               String                   @id @default(uuid()) @db.Uuid
  customerId       String                   @db.Uuid
  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  description      String
  totalAmount      Decimal                  @db.Decimal(12, 2)
  startDate        DateTime                 @db.Date
  installmentCount Int
  frequency        InstallmentPlanFrequency @default(MONTHLY)
  status           InstallmentPlanStatus    @default(ACTIVE)
  notes            String?                  @db.Text
  createdById      String                   @db.Uuid
  createdBy        User                     @relation("InstallmentPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  cancelledAt      DateTime?
  cancelledById    String?                  @db.Uuid
  cancelledBy      User?                    @relation("InstallmentPlanCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason     String?                  @db.Text

  installments Installment[]

  @@index([customerId])
  @@index([status])
  @@index([startDate])
  @@map("installment_plans")
}

model Installment {
  id                String            @id @default(uuid()) @db.Uuid
  installmentPlanId String            @db.Uuid
  installmentPlan   InstallmentPlan   @relation(fields: [installmentPlanId], references: [id], onDelete: Restrict)
  installmentNumber Int
  dueDate           DateTime          @db.Date
  amountDue         Decimal           @db.Decimal(12, 2)
  status            InstallmentStatus @default(PENDING)
  paidDate          DateTime?         @db.Date
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  paymentAllocations PaymentAllocation[]

  @@unique([installmentPlanId, installmentNumber])
  @@index([installmentPlanId])
  @@index([dueDate])
  @@index([status])
  @@index([installmentPlanId, status])
  @@map("installments")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @db.Date
  paymentMethod  PaymentMethod @default(CASH)
  reference      String?
  notes          String?       @db.Text
  idempotencyKey String?       @unique
  createdById    String        @db.Uuid
  createdBy      User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?
  voidedById     String?       @db.Uuid
  voidedBy       User?         @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason     String?       @db.Text

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
  @@index([createdById])
  @@map("payments")
}

model PaymentAllocation {
  id            String       @id @default(uuid()) @db.Uuid
  paymentId     String       @db.Uuid
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  debtId        String?      @db.Uuid
  debt          Debt?        @relation(fields: [debtId], references: [id], onDelete: Restrict)
  installmentId String?      @db.Uuid
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  amount        Decimal      @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())

  @@index([paymentId])
  @@index([debtId])
  @@index([installmentId])
  @@map("payment_allocations")
}
