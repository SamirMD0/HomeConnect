# Values Vite/Electron consume at BUILD TIME for a hosted-backend
# installer. VITE_API_URL is baked into the frontend bundle, so a
# rebuild of Electron is required whenever this changes.

VITE_API_URL=https://api.homeconnect.example.com/api/v1

# VITE_PORT is only for `npm run dev:vite`; irrelevant for hosted builds.
VITE_PORT=3002
