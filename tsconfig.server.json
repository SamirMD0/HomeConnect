{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/server",
    "rootDir": ".",
    "paths": {
      "@backend/*": [
        "./backend/src/*"
      ],
      "@desktop/*": [
        "./desktop/src/*"
      ]
    }
  },
  "exclude": ["backend/src/relay"],
  "include": [
    "backend/src",
    "desktop/src",
    "shared",
    "backend/src/features/maintenance/checksum-allowlist.json",
    "package.json"
  ]
}
