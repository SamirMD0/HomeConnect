{
  "expo": {
    "name": "HomeConnect Mobile Scanner",
    "slug": "homeconnect-mobile-scanner",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "versionCode": 6,
      "package": "com.homeconnect.mobilescanner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HomeConnect Mobile Scanner to scan product barcodes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HomeConnect to choose supplier bill photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "b1b5215c-65a4-49b0-8a86-9cf656dba998"
      }
    },
    "owner": "ryomen0",
    "scheme": "homeconnect",
    "experiments": {
      "typedRoutes": true
    }
  }
}
