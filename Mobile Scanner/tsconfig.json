{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@expo/vector-icons/*": [
        "./node_modules/@expo/vector-icons/*",
        "./node_modules/expo/node_modules/@expo/vector-icons/*"
      ],
      "@shared/*": [
        "../shared/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
