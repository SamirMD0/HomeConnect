# Values Render will actually run the backend with. Non-secret entries
# are baked into render.yaml; secrets marked <replace-in-render-dashboard>
# must be set through the Render dashboard on the service.

# Runtime
NODE_ENV=production
HOSTED_MODE=true
HOST=0.0.0.0
PORT=<supplied-by-render>

# Security
COOKIE_SECURE=true
JWT_SECRET=<replace-in-render-dashboard>
JWT_REFRESH_SECRET=<replace-in-render-dashboard>

# CORS — Electron's packaged renderer origin
FRONTEND_URL=http://127.0.0.1:3002
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Database — Neon pooled URL
DATABASE_URL=<replace-in-render-dashboard>

# Filesystem — empty disables file transports/schedulers
LOG_DIR=
BACKUP_SCHEDULE_CRON=

# Business
BUSINESS_TIMEZONE=Asia/Beirut
